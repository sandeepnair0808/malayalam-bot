# --- Claude (story + illustrations) ---
ANTHROPIC_API_KEY=sk-ant-...
# REELBOT_MODEL=claude-opus-5-5

# --- Visual style ---
# cartoon = Claude draws rigged flat SVG scenes, animated locally (only needs ANTHROPIC_API_KEY)
# 3d      = Pixar-style 3D: Gemini image model keyframes + Veo video clips (needs GEMINI_API_KEY)
REELBOT_STYLE=cartoon
# GEMINI_API_KEY=...                    # from aistudio.google.com
# REELBOT_IMAGE_MODEL=gemini-3.1-flash-image
# REELBOT_VIDEO_MODEL=veo-3.1-generate-preview
# REELBOT_VIDEO_RESOLUTION=720p        # or 1080p
# REELBOT_AI_VIDEO=1                   # 0 = 3D stills with camera motion only (much cheaper)
# Vertex AI instead of an API key: GOOGLE_GENAI_USE_VERTEXAI=true GOOGLE_CLOUD_PROJECT=... GOOGLE_CLOUD_LOCATION=us-central1

# --- Voice-over ---
# edge (free, natural ml-IN neural voices) | gtts | none
REELBOT_TTS=edge
REELBOT_VOICE=ml-IN-MidhunNeural       # fallback for uncast voices; or ml-IN-SobhanaNeural

# --- Instagram Graph API (Business/Creator account linked to a Facebook Page) ---
IG_USER_ID=1784...
IG_ACCESS_TOKEN=EAAG...
# IG_GRAPH_HOST=graph.facebook.com     # use graph.instagram.com for "Instagram API with Instagram Login" tokens
# IG_GRAPH_VERSION=v21.0

# --- Video ---
# REELBOT_FONT=Manjari                 # any installed Malayalam font family
# REELBOT_MUSIC_DIR=assets/music       # random track mixed under the voice, if any .mp3/.m4a present
